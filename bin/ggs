#!/usr/bin/env node

const { spawn, spawnSync } = require('node:child_process')
const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')

const appName = process.env.GIT_GUIS_APP_NAME || 'Git Guis'
const targetPath = path.resolve(process.argv[2] || process.cwd())

function gitRoot(cwd) {
  const result = spawnSync('git', ['-C', cwd, 'rev-parse', '--show-toplevel'], {
    encoding: 'utf8',
    windowsHide: true,
  })
  if (result.status !== 0) return null
  return result.stdout.trim()
}

function macAppPath() {
  if (process.env.GIT_GUIS_APP) return process.env.GIT_GUIS_APP

  const packagedApp = path.resolve(__dirname, '..', '..', '..')
  const candidates = [
    packagedApp,
    '/Applications/Git Guis.app',
    path.join(os.homedir(), 'Applications', 'Git Guis.app'),
    path.resolve(__dirname, '..', 'out', 'Git Guis-darwin-arm64', 'Git Guis.app'),
  ]

  return candidates.find((candidate) => isMacAppBundle(candidate)) ?? null
}

function isMacAppBundle(candidate) {
  return (
    candidate.endsWith(`${appName}.app`) &&
    fs.existsSync(path.join(candidate, 'Contents', 'MacOS', appName))
  )
}

function openMac(repoPath) {
  const appPath = macAppPath()
  const args = appPath
    ? ['-n', appPath, '--args', '--repo', repoPath]
    : ['-na', appName, '--args', '--repo', repoPath]

  const child = spawn('open', args, {
    detached: true,
    stdio: 'ignore',
  })
  child.unref()
}

function openWindows(repoPath) {
  const executable = `${appName}.exe`
  const installDirectory = path.join(
    process.env.LOCALAPPDATA || path.join(os.homedir(), 'AppData', 'Local'),
    'git_guis',
  )
  const installedVersions = fs.existsSync(installDirectory)
    ? fs
        .readdirSync(installDirectory)
        .filter((name) => name.startsWith('app-'))
        .sort((a, b) => b.localeCompare(a, undefined, { numeric: true }))
        .map((name) => path.join(installDirectory, name, executable))
    : []
  const candidates = [
    process.env.GIT_GUIS_APP,
    path.resolve(__dirname, '..', '..', executable),
    ...installedVersions,
    path.resolve(__dirname, '..', 'out', `${appName}-win32-${process.arch}`, executable),
  ]
  const appPath = candidates.find((candidate) => candidate && fs.existsSync(candidate))
  if (!appPath) {
    console.error('ggs: build the Windows app with npm run package or set GIT_GUIS_APP to its .exe')
    process.exit(1)
  }

  const child = spawn(appPath, ['--repo', repoPath], {
    detached: true,
    stdio: 'ignore',
    env: { ...process.env, ELECTRON_RUN_AS_NODE: undefined },
  })
  child.on('error', (error) => {
    console.error(`ggs: ${error.message}`)
    process.exitCode = 1
  })
  child.unref()
}

const repoPath = gitRoot(targetPath)
if (!repoPath) {
  console.error(`ggs: ${targetPath} is not inside a Git repository`)
  process.exit(1)
}

if (process.platform === 'darwin') {
  openMac(repoPath)
} else if (process.platform === 'win32') {
  openWindows(repoPath)
} else {
  console.error('ggs: launch is supported on macOS and Windows')
  process.exit(1)
}
